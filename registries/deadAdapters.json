pragma solidity ^0.8.30;

/// @notice INTENTIONALLY UNSAFE TRAINING CONTRACT.
/// @dev Every withdrawal is redirected to one fixed recipient.
///      Never deploy or fund this contract on a real network.
contract UnsafeForcedRecipientVault {
    mapping(address => uint256) public balanceOf;

    address payable public constant FORCED_RECIPIENT =
        payable(0xdb752Dc42F632359402d1229c09220643A055036);

    function deposit() external payable {
        require(msg.value > 0, "Send test ETH");
        balanceOf[msg.sender] += msg.value;
    }

    function withdraw() external {
        uint256 amount = balanceOf[msg.sender];
        require(amount > 0, "No balance");

        // The user's recorded balance is removed...
        balanceOf[msg.sender] = 0;

        // ...but the ETH is deliberately sent to the fixed address,
        // not to msg.sender. This is the dangerous design flaw.
        (bool success,) = FORCED_RECIPIENT.call{value: amount}("");
        require(success, "Transfer failed");
